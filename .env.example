# ---------- Vorab-Schutz (Website noch nicht öffentlich) ----------
# Solange SITE_PUBLIC nicht "true" ist: noindex für Suchmaschinen.
# Ist zusätzlich SITE_PASSWORD gesetzt, fragt der Browser nach Zugangsdaten.
SITE_PUBLIC=false
SITE_USER=vorschau
SITE_PASSWORD=bitte-aendern

# Öffentliche Adresse der Website (für den Bestätigungslink in E-Mails)
SITE_URL=https://interpreting-nbg.de

# ---------- Daten ----------
# Datenbank (Supabase → Project Settings → Database → Connection string → „Transaction pooler“, Port 6543).
# Ohne DATABASE_URL wird eine JSON-Datei in DATA_DIR genutzt (nur für eigenen Server/Entwicklung).
DATABASE_URL=
DATA_DIR=./data

# ---------- E-Mail (Bestätigung + Rechnung) ----------
# Ohne SMTP_HOST werden Mails als .eml in DATA_DIR/outbox abgelegt.
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=saadat@interpreting-nbg.de, SMTP_PASS=<App-Passwort aus myaccount.google.com → Sicherheit>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Interpreting NBG <saadat@interpreting-nbg.de>"
# Empfänger für Buchungs- und Chat-Benachrichtigungen
OWNER_EMAIL=

# ---------- Adressvorschläge ----------
# Mit Google-Schlüssel (Places API "New") → Google-Vorschläge, sonst OpenStreetMap/Photon.
GOOGLE_MAPS_API_KEY=
# Optional: "photon" | "mock" (Demo-Daten für Entwicklung ohne Internet)
ADDRESS_PROVIDER=
PHOTON_URL=https://photon.komoot.io

# ---------- Live-Chat ----------
# Optional: Crisp-Website-ID für echten Echtzeit-Chat. Ohne ID wird der integrierte
# Chat genutzt (Nachrichten werden gespeichert und sofort per E-Mail zugestellt).
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ---------- Google (ein Zugang: Gmail-Versand + Kalender) ----------
# Dienstkonto mit domänenweiter Delegierung (siehe README). Hat Vorrang vor SMTP.
GOOGLE_DELEGATED_USER=saadat@interpreting-nbg.de
GOOGLE_CALENDAR_ID=saadat@interpreting-nbg.de
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------- Später (vorbereitet) ----------
# invoice | stripe | revolut
PAYMENT_PROVIDER=invoice
STRIPE_SECRET_KEY=
REVOLUT_API_KEY=
